# Local Docker testing. The proxy is the only published service.
PUBLIC_URL=http://localhost:8080
SITE_ADDRESS=http://localhost
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Public deployment: use your domain for SITE_ADDRESS, https://your-domain
# for PUBLIC_URL, BIND_ADDRESS=0.0.0.0, HTTP_PORT=80 and HTTPS_PORT=443.
# Put credentials in .secrets/, never here. See docs/deployment.md.
# Optional administrative receipt copies (queued; requires an operator mail worker).
PAYMENT_ADMIN_EMAIL=
# Cash introductions stay disabled pending economy/abuse review and deployment approval.
FIRST_FRIEND_REWARDS_ENABLED=0
FIRST_FRIEND_NEW_REWARD=1000
FIRST_FRIEND_HOST_REWARD=500
